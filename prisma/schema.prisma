generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Los modelos siguen docs/02-modelo-de-datos.md. Secciones por módulo; toda tabla de negocio lleva companyId.

// =====================================================================================================
// CORE — empresas, sucursales, depósitos, usuarios, permisos, licencia, auditoría
// =====================================================================================================

enum IvaCondition {
  responsable_inscripto
  monotributo
  exento
}

// Razón social / CUIT. Una instalación (un cliente) puede tener varias: es común que el mismo dueño
// facture con más de un CUIT. Stock, precios por lista y comprobantes son siempre por empresa.
model Company {
  id                String       @id @default(cuid())
  legalName         String // razón social, tal cual figura en ARCA
  tradeName         String? // nombre de fantasía
  cuit              String       @unique // 11 dígitos, sin guiones
  ivaCondition      IvaCondition
  iibbNumber        String? // ingresos brutos (se imprime en los comprobantes)
  activityStartDate DateTime? // inicio de actividades (también obligatorio en el comprobante)
  address           String?
  active            Boolean      @default(true)

  branches    Branch[]
  warehouses  Warehouse[]
  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  address   String?
  active    Boolean @default(true)

  warehouses  Warehouse[]
  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

enum WarehouseKind {
  physical // local, galpón
  logical // "En tránsito", "Fallados", "Consignación"
}

enum NegativeStockPolicy {
  block // no deja que una venta/movimiento deje el saldo en negativo (default)
  warn // lo deja pasar con un aviso en la UI
  allow // lo deja pasar sin avisar (p.ej. mostrador que vende "a ciegas" por volumen)
}

model Warehouse {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branchId            String?
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  name                String
  kind                WarehouseKind       @default(physical)
  // El depósito desde el que vende y recibe la sucursal si no se elige otro. Uno por sucursal (se valida
  // en modules/core al guardar: Postgres no permite un unique parcial desde Prisma).
  isBranchDefault     Boolean             @default(false)
  active              Boolean             @default(true)
  negativeStockPolicy NegativeStockPolicy @default(block)

  stockMovements   StockMovement[]
  stockBalances    StockBalance[]
  stockReceipts    StockReceipt[]
  stockAdjustments StockAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([branchId])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique // siempre en minúsculas
  passwordHash String
  // Desarrollador / soporte: todos los permisos en todas las empresas, edita la licencia, y no aparece
  // en la lista de usuarios del cliente. Se crea solo por consola (scripts/create-superadmin.ts).
  isSuperadmin Boolean   @default(false)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Rol = conjunto de permisos (claves de src/modules/core/permissions.ts). Los roles de sistema se crean
// solos (seed) y no se pueden borrar; el cliente puede crear los suyos.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique // "owner", "cashier"... o un slug para roles propios
  name        String
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Qué puede hacer un usuario en una empresa. branchId null = en todas las sucursales de la empresa;
// con branchId, solo en esa (un cajero de una sucursal). Puede tener varias filas por empresa.
model Membership {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([userId, companyId, branchId])
  @@index([companyId])
}

// Licencia de la instalación: una sola fila (id = "installation"). La edita solo el superadmin.
// Sin fila = instalación sin licencia configurada: se habilita todo y el panel del superadmin lo avisa.
model InstallationLicense {
  id           String    @id @default("installation")
  clientName   String
  plan         String // nombre comercial del plan, solo informativo
  modules      String[]  @default([]) // claves de src/modules/core/modules.ts
  maxCompanies Int?
  maxBranches  Int?
  maxUsers     Int?
  // Vencida: el sistema pasa a solo lectura (nunca se bloquea ver datos ni comprobantes emitidos).
  expiresAt    DateTime?
  updatedAt    DateTime  @updatedAt
}

// Auditoría de acciones sensibles (precios, ajustes de stock, anulaciones, emisión fiscal, usuarios,
// configuración). before/after: el estado relevante antes y después, para poder reconstruir el cambio.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  userEmail  String
  action     String // código, ej. "user.create", "stock.adjust"
  targetType String?
  targetId   String?
  summary    String? // texto legible para la lista
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([targetType, targetId])
}

// Numeradores internos (nº de remito, presupuesto, ingreso...). Se incrementan con UPDATE ... RETURNING
// dentro de la transacción del documento: no hay huecos por rollback ni números repetidos.
// La numeración fiscal NO sale de acá: la manda ARCA (ver docs/03-facturacion-arca.md).
model Sequence {
  companyId String
  key       String // ej. "stock_receipt", "quote:0001"
  value     Int    @default(0)

  @@id([companyId, key])
}

// Configuración clave/valor. scope = "global" o el id de una empresa.
model Setting {
  scope     String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([scope, key])
}

enum OutboxStatus {
  pending
  processing
  done
  failed
}

// Eventos para afuera (webhooks a la tienda, mails, reintentos ARCA). Se escriben en la misma
// transacción que el cambio que los origina y los despacha el worker (F0.11) con reintentos.
model OutboxEvent {
  id            String       @id @default(cuid())
  companyId     String?
  type          String // ej. "stock.changed"
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
}

// =====================================================================================================
// CATALOG — unidades, productos, variantes (SKU) y códigos de barras. Ver docs/02-modelo-de-datos.md §2
// y docs/08-codigos-de-barras.md. Todo producto tiene al menos una variante (D-06): la simple tiene una
// sola, marcada isDefault, invisible en la UI — así el stock y las ventas siempre apuntan a variantId.
// =====================================================================================================

// un, kg, g, m, cm, lt, ml, caja, par, docena... `decimals` = cuántos decimales admite la cantidad
// (0 para "un", 3 para "kg"). Las conversiones entre unidades (1 caja = 12 un) llegan en F2.
model Unit {
  id        String @id @default(cuid())
  companyId String
  code      String // "un", "kg"
  name      String
  decimals  Int    @default(0)

  products Product[]

  @@unique([companyId, code])
}

enum ProductType {
  standard
  service // no controla stock (trackStock siempre false)
  kit // F2.10: se arma de componentes
}

enum ProductStatus {
  draft
  active
  archived
}

// Árbol de categorías (sin límite de niveles). Minimalista a propósito: F2 le suma SEO, imagen y orden
// cuando haya una tienda mostrándolas; por ahora solo organiza el catálogo interno.
model Category {
  id        String     @id @default(cuid())
  companyId String
  name      String
  slug      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, parentId])
}

model Product {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  slug        String
  type        ProductType   @default(standard)
  status      ProductStatus @default(draft)
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  baseUnitId String
  baseUnit   Unit    @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  ivaRate    Decimal @default(21) @db.Decimal(5, 2)

  trackStock   Boolean @default(true)
  trackLots    Boolean @default(false) // F2.11
  trackSerials Boolean @default(false) // F2.11

  variants Variant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@index([companyId, status])
}

model Variant {
  id        String  @id @default(cuid())
  companyId String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String
  isDefault Boolean @default(false) // true = la variante única de un producto simple (sin ejes)
  enabled   Boolean @default(true)

  // Precio simplificado (D-16): un precio plano por variante en vez del sistema completo de listas de
  // precios (PriceList/PriceListItem) que describe docs/02-modelo-de-datos.md §2.4 — ese llega en F2.7.
  // Vive en la variante (no en el producto) porque el precio puede variar entre talles/colores; hoy
  // todo producto tiene una sola variante, así que en la práctica es "el precio del producto".
  price          Decimal  @default(0) @db.Decimal(18, 4)
  compareAtPrice Decimal? @db.Decimal(18, 4) // precio de lista tachado, para mostrar un descuento
  costPrice      Decimal? @db.Decimal(18, 4) // costo manual; F1.10 lo reemplaza por el costo promedio

  barcodes             Barcode[]
  stockMovements       StockMovement[]
  stockBalances        StockBalance[]
  stockReceiptLines    StockReceiptLine[]
  stockAdjustmentLines StockAdjustmentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([productId])
}

enum BarcodeType {
  ean13
  ean8
  upca
  code128
  internal // generado por Udex para productos sin código de fábrica
}

// Un código → una sola variante. Una variante puede tener varios códigos (fabricante, caja con `factor`,
// interno). Ver docs/08-codigos-de-barras.md §2-3.
model Barcode {
  id        String      @id @default(cuid())
  companyId String
  code      String
  variantId String
  variant   Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  unitId    String? // null = unidad base del producto
  factor    Decimal     @default(1) @db.Decimal(18, 6) // cuántas unidades base entran/salen por escaneo
  type      BarcodeType @default(ean13)
  isPrimary Boolean     @default(false)

  createdAt DateTime @default(now())

  @@unique([companyId, code])
  @@index([variantId])
}

// =====================================================================================================
// INVENTORY — ledger de stock (inmutable) + saldos materializados + ingreso de mercadería por escaneo.
// Ver docs/02-modelo-de-datos.md §1 y docs/08-codigos-de-barras.md §6.
// =====================================================================================================

enum StockMovementType {
  initial
  purchase_receipt
  purchase_return
  sale
  sale_return
  adjustment
  count
  transfer_out
  transfer_in
  kit_assembly
  kit_disassembly
}

// Cada cambio de stock es una fila. NUNCA se edita ni se borra: un error se corrige con un movimiento
// inverso. El saldo (StockBalance) se actualiza en la misma transacción, bajo lock — ver
// modules/inventory/post.ts.
model StockMovement {
  id          String            @id @default(cuid())
  companyId   String
  variantId   String
  variant     Variant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantity    Decimal           @db.Decimal(18, 4) // con signo: + entra, - sale. En unidad base.
  unitCost    Decimal?          @db.Decimal(18, 4) // costo unitario de una entrada (valorización, F1.10)
  type        StockMovementType

  // Documento que lo originó.
  sourceType     String
  sourceId       String
  sourceLineId   String?
  idempotencyKey String? @unique
  note           String?
  userId         String?

  createdAt DateTime @default(now())

  @@index([companyId, variantId, warehouseId, createdAt])
  @@index([sourceType, sourceId])
}

// Saldo materializado: se mantiene igual a la suma del ledger (actualizado en la misma transacción que
// cada movimiento). disponible = onHand - reserved (se calcula, no se guarda).
model StockBalance {
  id          String    @id @default(cuid())
  companyId   String
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  onHand      Decimal   @default(0) @db.Decimal(18, 4)
  reserved    Decimal   @default(0) @db.Decimal(18, 4)
  incoming    Decimal   @default(0) @db.Decimal(18, 4)

  @@unique([variantId, warehouseId])
  @@index([companyId, warehouseId])
}

enum StockReceiptStatus {
  draft
  confirmed
  cancelled
}

// Ingreso de mercadería por escaneo (docs/08-codigos-de-barras.md §6). En F6 se le suma
// purchaseOrderId/supplierId reales; por ahora el proveedor es solo un texto de referencia.
model StockReceipt {
  id             String             @id @default(cuid())
  companyId      String
  warehouseId    String
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status         StockReceiptStatus @default(draft)
  supplierName   String?
  supplierDocRef String?
  userId         String

  lines StockReceiptLine[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  @@index([companyId, status])
}

model StockReceiptLine {
  id          String       @id @default(cuid())
  receiptId   String
  receipt     StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity    Decimal      @db.Decimal(18, 4)
  unitCost    Decimal?     @db.Decimal(18, 4)
  scannedCode String? // el código tal cual lo leyó la pistola (trazabilidad)
  sortOrder   Int          @default(0)

  createdAt DateTime @default(now())

  // Escanear el mismo producto otra vez suma a esta misma línea en vez de crear otra (docs/08 §6).
  @@unique([receiptId, variantId])
  @@index([receiptId])
}

enum StockAdjustmentStatus {
  draft
  confirmed
  cancelled
}

// Motivo del documento completo (F1.6): una corrección real siempre tiene UN porqué, no uno por línea.
enum StockAdjustmentReason {
  breakage // rotura
  theft // robo / faltante
  gift // obsequio / promoción
  count_error // corrección de un error de carga anterior
  other
}

// Ajuste manual de stock, mismo patrón de borrador→confirmar que StockReceipt, pero con cantidad CON
// SIGNO (una corrección puede sumar o restar) y motivo obligatorio. Ver docs/02-modelo-de-datos.md §1.
model StockAdjustment {
  id          String                @id @default(cuid())
  companyId   String
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status      StockAdjustmentStatus @default(draft)
  reason      StockAdjustmentReason
  note        String?
  userId      String

  lines StockAdjustmentLine[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  @@index([companyId, status])
}

model StockAdjustmentLine {
  id           String          @id @default(cuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delta        Decimal         @db.Decimal(18, 4) // con signo: + suma, - resta
  scannedCode  String?

  createdAt DateTime @default(now())

  @@unique([adjustmentId, variantId])
  @@index([adjustmentId])
}
