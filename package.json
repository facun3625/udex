{
  "name": "udex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p ${PORT:-3010}",
    "lint": "eslint",
    "test": "node --test tests/",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && prisma generate",
    "postinstall": "prisma generate",
    "superadmin": "tsx scripts/create-superadmin.ts",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "test:e2e": "node tests/e2e/run.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "lucide-react": "^1.52.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
